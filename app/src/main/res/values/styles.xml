<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Typography scale: a single place to keep the UI consistent. -->
    <style name="Text.Title" parent="">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Text.Headline" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>

    <style name="Text.Subtitle" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>

    <style name="Text.Body.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Caption" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">2sp</item>
    </style>

    <style name="Text.Label" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Text.SectionHeader" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.Mono" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>

    <style name="Text.OnGradient" parent="Text.Title">
        <item name="android:textColor">@color/on_gradient</item>
    </style>

    <style name="Text.OnGradient.Subtitle" parent="Text.Caption">
        <item name="android:textColor">@color/on_gradient_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Buttons -->
    <style name="Button.Primary" parent="">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_gradient</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingLeft">22dp</item>
        <item name="android:paddingRight">22dp</item>
        <item name="android:gravity">center</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Button.Secondary" parent="Button.Primary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Button.Ghost" parent="Button.Primary">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Button.Destructive" parent="Button.Primary">
        <item name="android:background">@drawable/bg_button_destructive</item>
        <item name="android:textColor">@color/error</item>
    </style>

    <style name="Widget.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:elevation">@dimen/elevation_card</item>
        <item name="android:padding">@dimen/space_l</item>
    </style>

    <style name="Widget.ListRow" parent="">
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingLeft">@dimen/space_l</item>
        <item name="android:paddingRight">@dimen/space_l</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.IconButton" parent="">
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:padding">@dimen/space_m</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Chip" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingLeft">@dimen/space_m</item>
        <item name="android:paddingRight">@dimen/space_m</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Bottom navigation -->
    <style name="Widget.NavTab" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/bg_icon_button_bare</item>
    </style>

    <style name="Widget.NavIcon" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
    </style>

    <style name="Widget.NavLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- An icon button with no container: for toolbars and rows -->
    <style name="Widget.IconButton.Bare" parent="">
        <item name="android:background">@drawable/bg_icon_button_bare</item>
        <item name="android:padding">@dimen/space_m</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Small metric tile on the home screen -->
    <style name="Widget.StatTile" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card_soft</item>
        <item name="android:padding">@dimen/space_m</item>
        <item name="android:gravity">start</item>
    </style>

    <!-- Inline notice row (permission, network, compatibility warnings) -->
    <style name="Widget.Banner" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_banner_warning</item>
        <item name="android:padding">@dimen/space_m</item>
    </style>

    <!-- Segmented control used for the library media filter -->
    <style name="Widget.Segment" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_segment</item>
        <item name="android:paddingLeft">@dimen/space_s</item>
        <item name="android:paddingRight">@dimen/space_s</item>
        <item name="android:paddingTop">@dimen/space_s</item>
        <item name="android:paddingBottom">@dimen/space_s</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.SegmentLabel" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Switches inherit the platform look; only the colour is ours. -->
    <style name="Widget.Switch" parent="">
        <item name="android:colorAccent">@color/primary</item>
    </style>

    <style name="Animation.MediaBridge.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out_slight</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in_slight</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="Animation.MediaBridge.Sheet" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_up</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out_slight</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in_slight</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_down</item>
    </style>
</resources>
