    <!-- Onboarding copy -->
    <string name="ob_welcome_title">Your phone, on the big screen</string>
    <string name="ob_welcome_body">MediaBridge turns this phone into a DLNA media server, the same standard LG televisions and other players already use for SmartShare and Photos &amp; Videos.</string>
    <string name="ob_welcome_point_1">The TV browses your phone and plays files directly — nothing is copied first.</string>
    <string name="ob_welcome_point_2">Nothing leaves your Wi‑Fi network. No account, no cloud, no internet upload.</string>
    <string name="ob_welcome_point_3">Keep using your phone while the TV plays: sharing survives the screen turning off.</string>
    <string name="ob_permission_title">Two permissions, both explained</string>
    <string name="ob_permission_body">MediaBridge asks for the smallest set of permissions it can work with, and only to do the two jobs below.</string>
    <string name="ob_permission_point_1">Photos, videos and music access — so the TV can read the files you choose to share.</string>
    <string name="ob_permission_point_2">Notification access — the mandatory notification that keeps sharing alive while your screen is off.</string>
    <string name="ob_permission_point_3">No call, contact, location or account access is ever requested.</string>
