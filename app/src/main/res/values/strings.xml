    <!-- Onboarding -->
    <string name="title_onboarding">Getting started</string>
    <string name="onboard_welcome_title">Your phone, on the big screen</string>
    <string name="onboard_welcome_body">MediaBridge turns this phone into a DLNA media server. Your LG TV finds it on your Wi‑Fi network and streams your videos, photos and music straight from the phone — nothing is uploaded anywhere.</string>
    <string name="onboard_net_title">One Wi‑Fi network</string>
    <string name="onboard_net_body">Connect the phone and the TV to the same Wi‑Fi network. Guest networks, client isolation and “AP isolation” on the router block device discovery — if the TV cannot see the phone, that is the first thing to check.</string>
    <string name="onboard_perm_title">Permissions</string>
    <string name="onboard_perm_body">Media library access lets the TV browse your photos, videos and music. Notifications keep the sharing service visible while the screen is off. Nothing else is requested.</string>
    <string name="onboard_tv_title">On the TV</string>
    <string name="onboard_tv_body">Open Photos &amp; Videos (or Music) on the TV, choose Device Selection, then pick “MediaBridge” from the list. webOS 6 also exposes the same list through SmartShare.</string>
    <string name="onboard_finish">Start sharing</string>
    <string name="onboard_progress">Step %1$d of %2$d</string>

