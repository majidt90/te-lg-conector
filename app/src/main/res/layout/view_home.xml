<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingLeft="@dimen/screen_padding"
    android:paddingRight="@dimen/screen_padding"
    android:paddingTop="@dimen/space_m"
    android:paddingBottom="@dimen/space_xl"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero: the one thing the user came for. -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/hero_icon"
                    android:layout_width="@dimen/icon_l"
                    android:layout_height="@dimen/icon_l"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cast" />

                <TextView
                    android:id="@+id/hero_state"
                    style="@style/Text.OnGradient"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_m"
                    android:layout_weight="1"
                    android:text="@string/home_hero_stopped" />
            </LinearLayout>

            <TextView
                android:id="@+id/hero_detail"
                style="@style/Text.OnGradient.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/home_hero_stopped_detail" />

            <LinearLayout
                android:id="@+id/hero_address_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_hero_overlay"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_m"
                android:visibility="gone">

                <TextView
                    android:id="@+id/hero_address"
                    style="@style/Text.Mono"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/on_gradient"
                    android:text="192.168.1.42:8200" />

                <ImageButton
                    android:id="@+id/hero_copy"
                    style="@style/Widget.IconButton.Bare"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:contentDescription="@string/cd_copy_address"
                    android:src="@drawable/ic_link" />
            </LinearLayout>

            <Button
                android:id="@+id/hero_action"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/action_start_server" />
        </LinearLayout>

        <TextView
            style="@style/Text.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/section_connected_tv" />

        <LinearLayout
            android:id="@+id/device_card"
            style="@style/Widget.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/device_card_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_l"
                    android:layout_height="@dimen/icon_l"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_tv" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_no_device_title" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_no_device_body" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/device_card_active"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/device_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_dot_ok" />

                    <TextView
                        android:id="@+id/device_name"
                        style="@style/Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/space_s"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/nav_devices" />

                    <TextView
                        android:id="@+id/device_badge"
                        style="@style/Widget.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chip_lg_webos" />
                </LinearLayout>

                <TextView
                    android:id="@+id/device_meta"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs" />

                <LinearLayout
                    android:id="@+id/device_now_playing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:background="@drawable/bg_card_soft"
                    android:orientation="vertical"
                    android:padding="@dimen/space_m"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/device_now_title"
                        style="@style/Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <ProgressBar
                        android:id="@+id/device_now_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/progress_height"
                        android:layout_marginTop="@dimen/space_xs"
                        android:max="100"
                        android:progressDrawable="@drawable/bg_progress_track" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/device_now_position"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/device_now_state"
                            style="@style/Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/control_rewind"
                            style="@style/Widget.IconButton.Bare"
                            android:layout_width="@dimen/touch_target"
                            android:layout_height="@dimen/touch_target"
                            android:contentDescription="@string/cd_rewind"
                            android:src="@drawable/ic_rewind" />

                        <ImageButton
                            android:id="@+id/control_play_pause"
                            style="@style/Widget.IconButton.Bare"
                            android:layout_width="@dimen/touch_target"
                            android:layout_height="@dimen/touch_target"
                            android:contentDescription="@string/cd_play_pause"
                            android:src="@drawable/ic_play" />

                        <ImageButton
                            android:id="@+id/control_stop"
                            style="@style/Widget.IconButton.Bare"
                            android:layout_width="@dimen/touch_target"
                            android:layout_height="@dimen/touch_target"
                            android:contentDescription="@string/cd_stop"
                            android:src="@drawable/ic_stop" />

                        <ImageButton
                            android:id="@+id/control_volume_down"
                            style="@style/Widget.IconButton.Bare"
                            android:layout_width="@dimen/touch_target"
                            android:layout_height="@dimen/touch_target"
                            android:contentDescription="@string/cd_volume_down"
                            android:src="@drawable/ic_arrow_down" />

                        <ImageButton
                            android:id="@+id/control_volume_up"
                            style="@style/Widget.IconButton.Bare"
                            android:layout_width="@dimen/touch_target"
                            android:layout_height="@dimen/touch_target"
                            android:contentDescription="@string/cd_volume_up"
                            android:src="@drawable/ic_volume" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/device_open"
                        style="@style/Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_view_details" />

                    <Button
                        android:id="@+id/device_disconnect"
                        style="@style/Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/space_s"
                        android:text="@string/action_disconnect" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Text.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/section_library" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/stat_videos"
                style="@style/Widget.StatTile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/stat_videos_value"
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/media_videos" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stat_photos"
                style="@style/Widget.StatTile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_s"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/stat_photos_value"
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/media_photos" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stat_music"
                style="@style/Widget.StatTile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_s"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/stat_music_value"
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/media_music" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/library_warning"
            style="@style/Widget.Banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:background="@drawable/bg_banner_warning"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/icon_m"
                android:layout_height="@dimen/icon_m"
                android:contentDescription="@null"
                android:src="@drawable/ic_warning" />

            <TextView
                android:id="@+id/library_warning_text"
                style="@style/Text.Body.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/space_s"
                android:layout_weight="1" />

            <Button
                android:id="@+id/library_warning_action"
                style="@style/Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_grant" />
        </LinearLayout>

        <TextView
            style="@style/Text.SectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/section_recent_streams" />

        <LinearLayout
            android:id="@+id/recent_card"
            style="@style/Widget.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/recent_empty"
                style="@style/Text.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_no_streams" />

            <LinearLayout
                android:id="@+id/recent_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/open_sessions"
            style="@style/Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="@string/action_open_sessions" />
    </LinearLayout>
</ScrollView>
